    "definitions": {
        "handlers.CreateRideRequest": {
            "type": "object",
            "required": [
                "destination_latitude",
                "destination_longitude",
                "pickup_latitude",
                "pickup_longitude"
            ],
            "properties": {
                "destination_latitude": {
                    "type": "number"
                },
                "destination_longitude": {
                    "type": "number"
                },
                "pickup_latitude": {
                    "type": "number"
                },
                "pickup_longitude": {
                    "type": "number"
                }
            }
        },
        "handlers.CreateVehicleRequest": {
            "type": "object",
            "required": [
                "capacity",
                "model",
                "registration_number"
            ],
            "properties": {
                "capacity": {
                    "type": "integer",
                    "maximum": 10,
                    "minimum": 1
                },
                "model": {
                    "type": "string"
                },
                "registration_number": {
                    "type": "string"
                }
            }
        },
        "handlers.LoginRequest": {
            "type": "object",
            "required": [
                "password",
                "phone"
            ],
            "properties": {
                "password": {
                    "type": "string"
                },
                "phone": {
                    "type": "string"
                }
            }
        },
        "handlers.RegisterRequest": {
            "type": "object",
            "required": [
                "name",
                "password",
                "phone",
                "role"
            ],
            "properties": {
                "name": {
                    "type": "string"
                },
                "password": {
                    "type": "string",
                    "minLength": 8
                },
                "phone": {
                    "type": "string"
                },
                "role": {
                    "type": "string"
                }
            }
        },
        "handlers.UpdateAvailabilityRequest": {
            "type": "object",
            "required": [
                "is_available"
            ],
            "properties": {
                "is_available": {
                    "type": "boolean"
                }
            }
        },
        "handlers.UpdateLocationRequest": {
            "type": "object",
            "required": [
                "latitude",
                "longitude"
            ],
            "properties": {
                "latitude": {
                    "type": "number"
                },
                "longitude": {
                    "type": "number"
                }
